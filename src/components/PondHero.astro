---
/**
 * Full-bleed interactive pond — sediment / water / token drops.
 */
import { withBase } from "../lib/base";
---

<section class="hero" aria-label="Interactive pond digital twin">
  <canvas class="hero-canvas" id="pond-canvas" aria-hidden="true"></canvas>
  <div class="hero-veil"></div>
  <div class="hero-content">
    <div class="hero-copy">
      <p class="tag">PondScope Ecosystem · AI Learning Tool</p>
      <h1 class="brand">A living pond for<br /><em>machine memory</em></h1>
      <p class="lead">
        Sediment is pre-trained weight. Water is runtime state. Each token is a stone —
        click the surface or drop a word below. Drag viscosity (latency) and pollution
        (token bloat) to feel the metaphor move.
      </p>
      <p class="legend" aria-hidden="true">
        <span><i class="sediment"></i>Sediment · weights</span>
        <span><i class="water"></i>Water · activations</span>
        <span><i class="token"></i>Drops · tokens</span>
      </p>
      <div class="hero-actions">
        <a class="cta" href="#path">Enter the path</a>
        <a class="cta ghost" href={withBase("pond-continuous.html")}>Open Lab 01</a>
      </div>
    </div>

    <div class="hero-controls" role="group" aria-label="Pond controls">
      <h2>Lab twin controls</h2>
      <p class="hint">Play with the digital twin before the lessons. Same geography as Labs 01–04.</p>

      <div class="control-row">
        <label for="viscosity">Viscosity <span id="viscosity-out">120 ms TTFT feel</span></label>
        <input id="viscosity" type="range" min="0" max="100" value="28" />
      </div>
      <div class="control-row">
        <label for="pollution">Pollution <span id="pollution-out">clear context</span></label>
        <input id="pollution" type="range" min="0" max="100" value="12" />
      </div>
      <div class="token-row">
        <label class="visually-hidden" for="token-input">Token text</label>
        <input id="token-input" type="text" placeholder="Type a token…" maxlength="80" autocomplete="off" />
        <button type="button" id="drop-btn">Drop</button>
      </div>
    </div>
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }
</style>

<script>
  import { initPondHero } from "../scripts/pond-hero";

  const canvas = document.getElementById("pond-canvas") as HTMLCanvasElement | null;
  const viscosityEl = document.getElementById("viscosity") as HTMLInputElement | null;
  const pollutionEl = document.getElementById("pollution") as HTMLInputElement | null;
  const viscosityOut = document.getElementById("viscosity-out");
  const pollutionOut = document.getElementById("pollution-out");
  const tokenInput = document.getElementById("token-input") as HTMLInputElement | null;
  const dropBtn = document.getElementById("drop-btn") as HTMLButtonElement | null;

  if (
    canvas &&
    viscosityEl &&
    pollutionEl &&
    viscosityOut &&
    pollutionOut &&
    tokenInput &&
    dropBtn
  ) {
    initPondHero({
      canvas,
      viscosityEl,
      pollutionEl,
      viscosityOut,
      pollutionOut,
      tokenInput,
      dropBtn,
    });
  }
</script>
